#!/bin/sh
# pre-push -- privacy gate on the manual push path (**template**: to change it, edit
# tools/git-hooks/pre-push and reinstall)
#
# Install: python tools/install_git_hooks.py          (idempotent; writes .git/hooks/pre-push + two sidecars)
# Verify:  python tools/install_git_hooks.py --check  (the installed copy is byte-identical to the template; core.hooksPath was not redirected)
# Test:    python verify/selftest_prepush_hook.py     (9 fixture cases, including a measured --no-verify bypass)
#
# Why: the automatic export job's exit has a gate (the export step), but the **manual**
# `git commit && git push` path previously had no gate at all -- the measured leak came in
# through exactly this manual commit.
#
# Check: tree (leakscan) + messages about to be pushed (pushscope_gate) + object content in the
# range about to be pushed (history_gate), via verify/prepush_gate.py. Any non-zero (including
# UNDECIDABLE=2) = refuse this push.
# Local commits are unaffected: stopping is reversible, publishing is not.
#
# Limit: `git push --no-verify` bypasses it outright (one self-test case measures exactly that);
# .git/hooks/ is not version-controlled, so other clones do not have this gate. Everything is
# located with shell builtins only -- the cron service has no PATH.
set -u

case "$0" in
  */*) hook_dir=${0%/*} ;;
  *)   hook_dir=. ;;
esac
hook_dir=$(cd "$hook_dir" 2>/dev/null && pwd) || exit 1
# The argv handed to **native** python must be a native path: an MSYS form (the kind starting
# with a slash) is re-interpreted once it reaches a native process -- measured: the gate reported
# "can't open file ...prepush_gate.py" under a temp dir, i.e. the temp dir had been glued under
# the current drive root (the first self-test run was stopped by exactly this). So use the MSYS
# form for the shell's file tests and `pwd -W`'s native form for python's argv; there is no
# `pwd -W` on Linux, so fall back to the POSIX form (there the POSIX path is already native).
# Note: the descriptions below **do not write the sample itself** -- this file is inside this
# gate's own scan surface too.
base=$(cd "$hook_dir/../.." 2>/dev/null && pwd) || exit 1
repo_sh="$base"
repo=$(cd "$base" && pwd -W 2>/dev/null) || repo=""
[ -n "$repo" ] || repo="$repo_sh"
gate="$repo/verify/prepush_gate.py"
gate_sh="$repo_sh/verify/prepush_gate.py"

refuse() {
  echo "pre-push REFUSED: $1" >&2
  echo "  (fail-closed: the gate did not run / returned non-zero, so nothing is let through; local commits are unaffected.)" >&2
  exit 1
}

[ -f "$gate_sh" ] || refuse "gate not found at $gate_sh"

py=""
if [ -f "$hook_dir/pre-push.python" ]; then
  IFS= read -r py < "$hook_dir/pre-push.python" || py=""
  [ -n "$py" ] && [ -f "$py" ] || py=""
fi
if [ -z "$py" ]; then
  for c in python3 python; do
    p=$(command -v "$c" 2>/dev/null) || p=""
    if [ -n "$p" ]; then py="$p"; break; fi
  done
fi
[ -n "$py" ] || refuse "no python interpreter found (cron has no PATH) -- run tools/install_git_hooks.py once with any python to write the sidecar"

gb=""
if [ -f "$hook_dir/pre-push.git" ]; then
  IFS= read -r gb < "$hook_dir/pre-push.git" || gb=""
  [ -n "$gb" ] && [ -f "$gb" ] || gb=""
fi

rc=0
while read -r lref lsha rref rsha; do
  [ -n "${lref:-}" ] || continue
  case "$rsha" in 0000000000000000000000000000000000000000) rsha="" ;; esac
  if [ -n "$rsha" ]; then
    if [ -n "$gb" ]; then
      "$py" "$gate" --repo "$repo" --upstream "$rsha" --git "$gb" || rc=1
    else
      "$py" "$gate" --repo "$repo" --upstream "$rsha" || rc=1
    fi
  else
    if [ -n "$gb" ]; then
      "$py" "$gate" --repo "$repo" --git "$gb" || rc=1
    else
      "$py" "$gate" --repo "$repo" || rc=1
    fi
  fi
done
[ "$rc" -eq 0 ] || refuse "privacy gate returned non-zero (every [gate] / LEAK line above is the check output)"
exit 0
